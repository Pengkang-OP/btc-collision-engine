{
    "_comment": "gpu-multi template - multi-GPU mode with performance load balancing",
    "_comment_max_threads": "8 threads for multi-GPU parallel task scheduling",
    "_comment_batch_size": "4M keys per batch, optimized for multi-GPU throughput",
    "_comment_gpu_mode": "multi-device with performance-based load balancing and auto-tuning",
    "_comment_device_index": "-1 means auto-detect all available GPU devices",
    "_comment_queue_depth": "16 async operation queue depth for deep pipelining",
    "_comment_key_strategy": "PRNG_SEED: GPU-side seed-based key generation, no CPU transfer",
    "_comment_memory_pool": "GPU memory pool enabled for reduced allocation overhead",
    "_comment_uint32_workaround": "false: modern GPUs handle uint32 natively",
    "_comment_constant_time": "false: raw throughput preferred for collision search",
    "version": "5.0.0",
    "engine": {
        "mode": "random",
        "batch_size": 4194304,
        "max_threads": 8
    },
    "collision": {
        "max_workers": 8,
        "progress_interval": 2000,
        "dedup_max_size": 2000000,
        "use_performance_optimization": true,
        "precomputed_window_size": 8,
        "use_simd_hash": true,
        "use_memory_pool": true,
        "use_gpu_memory_pool": true
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "logs/collision.log",
        "max_bytes": 20971520,
        "backup_count": 10,
        "enable_console": true,
        "enable_file": true
    },
    "gpu": {
        "use_gpu": true,
        "device_index": -1,
        "batch_size": 4194304,
        "auto_detect": true,
        "memory_usage_ratio": 0.70,
        "enable_vendor_optimizations": true,
        "queue_depth": 16,
        "use_new_module": true,
        "async_execution": true,
        "seed_prefetch_size": 128,
        "timeout_protection": true,
        "base_timeout_seconds": 60,
        "max_error_retries": 200,
        "gpu_memory_pool": true,
        "max_buffers": 200,
        "max_memory_mb": 16384,
        "mode": "multi",
        "device_indices": [-1],
        "load_balancing": "performance",
        "auto_tuning": true,
        "work_group_size": 256,
        "use_fast_math": true,
        "use_uint32_workaround": false,
        "driver_check": {
            "enabled": true,
            "require_minimum_version": true,
            "warn_on_unstable": true,
            "auto_fallback_conservative": true
        },
        "key_generation_strategy": "PRNG_SEED"
    },
    "optimization": {
        "uint32_workaround": true,
        "disable_async_transfer": false,
        "conservative_memory_policy": false,
        "adaptive_timeout": true
    },
    "crypto": {
        "backend": "auto",
        "constant_time": false,
        "verify_checksums": true,
        "strict_wif_validation": true,
        "use_gpu": true,
        "gpu_device_index": -1,
        "gpu_batch_size": 131072
    }
}
