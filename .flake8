[flake8]
max-line-length = 105
ignore = E203,W503
exclude = .git,__pycache__,.mypy_cache,.pytest_cache,venv,build,dist,docs/archive,./docs/archive
per-file-ignores =
    # Utility/long-line files in src
    src/web/dashboard.py: E501
    src/monitoring/alert_notifications.py: E501
    src/utils/ui_tutorial.py: E501
    src/collision/targets/validator.py: E501
    src/automation/*.py: E402
    src/collision/gpu/engine.py: E501
    src/collision/gpu/kernel_adapter.py: E501
    src/collision/gpu/key_generator.py: E501
    src/collision/gpu/protocols.py: E501
    src/collision/multiprocess_engine.py: E501
    src/cli/commands.py: E501
    src/cli/arg_parser.py: E501
    .\src\cli\commands.py: E501
    # Scripts: long lines and late imports
    scripts/__init__.py: E501,E402
    scripts/**/*.py: E501,E402
    scripts/_batch_p1.py: E501
    scripts/extract_opencl_kernels.py: E501
    # Benchmarks: long lines and late imports
    benchmarks/*.py: E501,E402
    # Root-level scripts/tools
    key_collision.py: E501,E128,E226
    run_audit_tools.py: E501,E231,E741
    run_full_audit.py: E501,E231,E226
    conftest.py: E501,E402
    .\conftest.py: E501,E402
    .\tests\*.py: E501
    .\tests\gpu\*.py: E501
    .\.qoder\hooks\block_risky.py: E501
