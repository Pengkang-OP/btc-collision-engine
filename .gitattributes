# .gitattributes 自引用
.gitattributes text eol=lf

# 自动检测文本文件换行符
* text=auto

# Shell 脚本必须使用 LF
*.sh text eol=lf

# PowerShell 脚本使用 CRLF（Windows 原生）
*.ps1 text eol=crlf

# Windows 批处理必须使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Python 源码统一 LF
*.py text eol=lf

# 配置文件统一 LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Markdown 文档统一 LF
*.md text eol=lf

# 纯文本文件统一 LF
*.txt text eol=lf
*.lock text eol=lf

# Docker 相关文件统一 LF
Dockerfile* text eol=lf
.dockerignore text eol=lf

# Git 配置文件统一 LF
.gitignore text eol=lf
.gitmodules text eol=lf

# 许可证统一 LF
LICENSE text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
