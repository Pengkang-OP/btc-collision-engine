# 自动检测文本文件换行符
* text=auto

# Shell 脚本必须使用 LF
*.sh text eol=lf

# Windows 批处理必须使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Python 源码统一 LF
*.py text eol=lf

# 配置文件统一 LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Markdown 文档统一 LF
*.md text eol=lf

# Docker 相关文件统一 LF
Dockerfile text eol=lf
.dockerignore text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
