{
  "_comment": "BTC私钥碰撞工具优化配置 - 高性能场景",
  "crypto": {
    "backend": "auto",
    "use_gpu": true,
    "gpu_device_index": -1,
    "constant_time": false,
    "verify_checksums": true,
    "strict_wif_validation": true
  },
  "engine": {
    "mode": "random",
    "batch_size": 1048576,
    "max_threads": 8,
    "checkpoint_interval": 300
  },
  "collision": {
    "max_workers": null,
    "progress_interval": 1000,
    "checkpoint_interval": 30,
    "dedup_max_size": 1000000,
    "use_performance_optimization": true,
    "precomputed_window_size": 8,
    "use_simd_hash": true,
    "use_memory_pool": true
  },
  "gpu": {
    "use_new_module": true,
    "auto_detect": true,
    "device_indices": [-1],
    "memory_usage_ratio": 0.70,
    "gpu_memory_pool": true,
    "max_buffers": 200,
    "max_memory_mb": 8192,
    "async_execution": true,
    "queue_depth": 0,
    "seed_prefetch_size": 256,
    "timeout_protection": true,
    "base_timeout_seconds": 30,
    "max_error_retries": 100,
    "enable_vendor_optimizations": true,
    "driver_check": {
      "enabled": true,
      "require_minimum_version": true,
      "warn_on_unstable": true,
      "auto_fallback_conservative": true
    },
    "mode": "auto",
    "load_balancing": "performance",
    "auto_tuning": true,
    "per_device_config": {
      "0": {
        "batch_size": 1048576,
        "work_group_size": 512
      }
    }
  },
  "optimization": {
    "uint32_workaround": true,
    "disable_async_transfer": false,
    "conservative_memory_policy": false,
    "adaptive_timeout": true
  },
  "monitoring": {
    "enabled": true,
    "report_interval": 60,
    "log_level": "INFO",
    "enable_memory_monitoring": true,
    "enable_timeout_monitoring": true,
    "collection_interval": 5,
    "storage_dir": "monitoring_data",
    "history_max_size": 1000,
    "error_max_size": 500,
    "anomaly_thresholds": {
      "speed": { "min": 100, "max": 1000000 },
      "cpu_usage": { "max": 90 },
      "memory_usage": { "max": 1024 }
    },
    "auto_cleanup": {
      "enabled": true,
      "max_age_days": 30
    }
  },
  "performance_monitoring": {
    "enabled": true,
    "max_records": 10000,
    "slow_threshold_ms": 5000,
    "track_slow_operations": true,
    "log_level": "INFO"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/collision.log",
    "max_bytes": 10485760,
    "backup_count": 5,
    "enable_console": true,
    "enable_file": true,
    "rotation_type": "size",
    "rotation_when": "midnight",
    "rotation_interval": 1,
    "compress_backups": false
  },
  "i18n": {
    "language": "auto",
    "fallback_language": "en_US"
  }
}