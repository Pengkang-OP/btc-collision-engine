{
  "engine": {
    "mode": "random",
    "batch_size": 262144,
    "max_threads": 8,
    "checkpoint_interval": 300
  },
  "gpu": {
    "use_gpu": true,
    "device_index": 0,
    "gpu_memory_pool": true,
    "max_buffers": 100,
    "max_memory_mb": 1024,
    "async_execution": true,
    "timeout_protection": true,
    "base_timeout_seconds": 30,
    "memory_limit_percent": 70,
    "memory_efficiency": 0.7
  },
  "monitoring": {
    "enable_performance_monitor": true,
    "report_interval": 60,
    "log_level": "INFO",
    "enable_memory_monitoring": true,
    "enable_timeout_monitoring": true
  },
  "optimization": {
    "uint32_workaround": true,
    "disable_async_transfer": false,
    "conservative_memory_policy": false,
    "adaptive_timeout": true
  },
  "_comment_device_index": "GPU设备索引: 0=NVIDIA GTX 1660 Ti, 1=Intel Arc A770",
  "_comment_batch_size": "批次大小: 65536(保守) 131072(平衡) 262144(最优) 1000000(测试)",
  "_comment_async": "异步执行已启用(双缓冲优化),如不稳定可设为false",
  "_comment_workaround": "Intel Arc必须启用uint32 workaround避免hang bug"
}