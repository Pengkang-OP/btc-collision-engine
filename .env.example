# BTC Collision Engine - 环境变量配置

# 日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
# BTC_ENGINE_LOG_LEVEL=INFO

# 数据目录（相对于项目根目录）
# BTC_ENGINE_DATA_DIR=./data

# 日志目录
# BTC_ENGINE_LOG_DIR=./logs

# 监控数据目录
# BTC_ENGINE_MONITOR_DIR=./monitoring

# 配置文件路径
# BTC_ENGINE_CONFIG_FILE=config.json

# GPU 加速启用
# BTC_ENGINE_GPU_ENABLE=true

# GPU 设备索引（-1 自动选择）
# BTC_ENGINE_GPU_DEVICE_INDEX=-1

# GPU 批处理大小
# BTC_ENGINE_GPU_BATCH_SIZE=1048576

# 异步队列深度 (1-16)
# BTC_ENGINE_GPU_QUEUE_DEPTH=4

# 监控采样间隔（秒）
# BTC_ENGINE_MONITOR_INTERVAL=5

# 加密后端 (auto/coincurve/cryptography/ecdsa/pure)
# BTC_ENGINE_CRYPTO_BACKEND=auto
