# BTC Collision Engine - 环境变量配置

# Web 仪表板 API 认证密钥 (与 --api-key 参数等效)
# 不设置则不启用认证，所有端点可公开访问
# DASHBOARD_API_KEY=your-secret-key

# GPU 双缓冲开关 (1=启用, 0=禁用)
# BTC_GPU_DOUBLE_BUFFER=1

# GPU 日志速率限制 (秒)
# GPU_LOG_RATE_LIMIT_SEC=60

# (已废弃) Intel GPU 日志速率限制，请使用 GPU_LOG_RATE_LIMIT_SEC
# INTEL_LOG_RATE_LIMIT_SEC=60

# 禁用控制台日志输出 (1/true/yes 禁用)
# DISABLE_CONSOLE_LOG=0

# 允许原始 secp256k1 实现 (设为 1 可抑制警告)
# BTC_COLLISION_RAW_SECP256K1_OK=0

# 禁用彩色输出 (遵循 https://no-color.org/)
# NO_COLOR=0
